# AETHER Environment Variables
# Copy to .env and fill in your values

# App
BETTER_AUTH_URL=http://localhost:8080
VITE_AUTH_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# NextAuth
NEXTAUTH_URL=http://localhost:8080
NEXTAUTH_SECRET=your-nextauth-secret

# Database (PostgreSQL connection string for production)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Solana / Helius
HELIUS_API_KEY=your-helius-api-key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key

# Encryption
ENCRYPTION_KEY=your-32-byte-encryption-key

# ClawPump
CLAWPUMP_API_KEY=
CLAW_TOKEN_MINT=739dnZEG4yaBWFsY8L8ZwrfhGG6dhtCSercW8Umspump
ANSEM_TOKEN_MINT=

# PayBox
PAYBOX_API_URL=

# Telegram
TELEGRAM_BOT_TOKEN=

# Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Wallet
OWS_WALLET_NAME=

# LLM Provider (any OpenAI-compatible API)
# providerBaseUrl, providerModel, providerKey set via Settings UI

# Deployment (CI only — never commit real tokens)
# GITHUB_TOKEN=
# VERCEL_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:8080
